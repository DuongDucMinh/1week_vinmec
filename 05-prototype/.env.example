HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/local-demo.sqlite
# Optional server-only credentials. Never expose via VITE_ variables.
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
# Vietnamese cloud navigation speech, independent of the AI assistant.
# Create an Azure Speech resource (Free F0 is suitable for a demo).
# Use the key and region of that resource. Never use VITE_ variables for secrets.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Supported: vi-VN-HoaiMyNeural (female), vi-VN-NamMinhNeural (male).
AZURE_SPEECH_VOICE=vi-VN-HoaiMyNeural
